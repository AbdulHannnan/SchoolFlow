# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public base URL of the app (used by Auth.js and for building links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Module 0.2) -------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school?schema=public"

# --- Auth.js (Module 1.3) --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Email: Brevo (Module 4.2) --------------------------------------------
# BREVO_API_KEY=""
# EMAIL_FROM="no-reply@example.com"

# --- WhatsApp: Cloud API / BSP (Module 4.3) -------------------------------
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Web Push: Firebase Cloud Messaging (Module 4.4) ----------------------
# NEXT_PUBLIC_FIREBASE_CONFIG=""
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- Payments (Module 6.5 / 6.6) ------------------------------------------
# JAZZCASH_MERCHANT_ID=""
# JAZZCASH_PASSWORD=""
# JAZZCASH_INTEGRITY_SALT=""
# EASYPAISA_STORE_ID=""
# EASYPAISA_HASH_KEY=""
