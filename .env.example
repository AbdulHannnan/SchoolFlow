# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public base URL of the app (used by Auth.js and for building links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Module 0.2 / RLS in 1.5) ------------------------------------
# PostgreSQL connection strings used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# DATABASE_URL — the OWNER role. Used for migrations, auth lookups, and
#   SUPER_ADMIN operations. Bypasses Row-Level Security.
# APP_DATABASE_URL — a NON-superuser role the app uses for tenant data so RLS
#   is enforced. Create it first: psql -d school -f prisma/sql/app-role.sql
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school?schema=public"
APP_DATABASE_URL="postgresql://school_app:school_app@localhost:5432/school?schema=public"

# --- Auth.js (Module 1.3) --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Email: Brevo (Module 4.2) --------------------------------------------
# Transactional email via Brevo (https://app.brevo.com). Set both BREVO_API_KEY
# and EMAIL_FROM to enable the email channel; with either unset it is skipped
# (dev-safe) and only the in-app channel delivers. EMAIL_FROM must be a sender
# you've verified in Brevo. EMAIL_FROM_NAME is optional (display name).
# BREVO_API_KEY=""
# EMAIL_FROM="no-reply@example.com"
# EMAIL_FROM_NAME="School Management"

# --- WhatsApp: Cloud API / BSP (Module 4.3) -------------------------------
# WhatsApp Cloud API. Set WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN to
# enable the channel; with either unset it is skipped (dev-safe). WhatsApp only
# sends pre-approved utility templates, so template names/language must match
# what's approved in your Meta WhatsApp Business account.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# WHATSAPP_TEMPLATE_ATTENDANCE_ABSENT="attendance_absent"

# --- Web Push: Firebase Cloud Messaging (Module 4.4) ----------------------
# Web Push via FCM. The client needs the public Firebase config + a Web Push
# (VAPID) key; the server needs a service-account key to send. With the server
# key unset, the web-push channel is skipped (dev-safe); with the client config
# unset, the browser never offers to enable push.
#
# NEXT_PUBLIC_FIREBASE_CONFIG — the Firebase web config as a JSON string, e.g.
#   {"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# NEXT_PUBLIC_FIREBASE_VAPID_KEY — the Web Push certificate key pair (public key)
# FIREBASE_SERVICE_ACCOUNT_KEY — the service-account JSON (raw or base64-encoded)
# NEXT_PUBLIC_FIREBASE_CONFIG=""
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- Payments (Module 6.5 / 6.6) ------------------------------------------
# JAZZCASH_MERCHANT_ID=""
# JAZZCASH_PASSWORD=""
# JAZZCASH_INTEGRITY_SALT=""
# EASYPAISA_STORE_ID=""
# EASYPAISA_HASH_KEY=""
