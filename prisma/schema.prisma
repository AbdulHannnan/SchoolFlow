// Prisma schema for the School Management SaaS.
// Docs: https://pris.ly/d/prisma-schema
//
// Models are added per roadmap module:
//   Module 1.1 — School (tenant)
//   Module 1.2 — User (roles, scoped by schoolId)
//   ...and onward. This baseline establishes the datasource, generator,
//   and migration pipeline only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in `prisma.config.ts` (for the CLI)
  // and is passed via a driver adapter to `PrismaClient` at runtime.
}

/// A School is the tenant. Every tenant-scoped record (users, students,
/// attendance, fees, …) will reference a School via `schoolId`, and in
/// Module 1.5 PostgreSQL Row-Level Security pins queries to one tenant.
///
/// `slug` is the stable, URL-safe handle used to resolve the active tenant
/// (subdomain or path). `isActive` lets a SUPER_ADMIN suspend a tenant
/// without deleting its data.
model School {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  users                  User[]
  classes                Class[]
  sections               Section[]
  subjects               Subject[]
  teacherAssignments     TeacherAssignment[]
  students               Student[]
  parentStudents         ParentStudent[]
  attendance             Attendance[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  diaryEntries           DiaryEntry[]
  feeCategories          FeeCategory[]
  feeStructures          FeeStructure[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  payments               Payment[]
  exams                  Exam[]
  examSubjects           ExamSubject[]
  examResults            ExamResult[]
  redFlags               RedFlag[]
  timetableEntries       TimetableEntry[]
  staffAttendance        StaffAttendance[]
  plannerEntries         PlannerEntry[]
  meetings               Meeting[]
  meetingInvitees        MeetingInvitee[]
  examPapers             ExamPaper[]
  classNotes             ClassNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

/// Roles are hierarchical in practice but stored flat; access control
/// (Module 1.4) maps each role to its permissions.
///   SUPER_ADMIN — platform operator; not tied to any tenant (schoolId null)
///   HEAD        — school owner/principal; full control within their school
///   TEACHER     — marks attendance, posts homework, enters grades
///   PARENT      — views their children's data
///   STUDENT     — views their own data
enum Role {
  SUPER_ADMIN
  HEAD
  TEACHER
  PARENT
  STUDENT

  @@map("role")
}

/// An authenticated account, scoped to one School via `schoolId`. The only
/// exception is SUPER_ADMIN, whose `schoolId` is null because it operates
/// above any single tenant. Email is unique *per school* (compound unique),
/// so the same address can belong to a parent at two different schools.
model User {
  id            String   @id @default(cuid())
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  name          String
  /// Contact number in E.164 form (e.g. "923001234567"), used by the WhatsApp
  /// notification channel (Module 4.3). Optional: not every account has one.
  phone         String?
  /// National ID (Pakistani CNIC), 13 digits stored normalized. Used for
  /// parents/guardians; optional and null for other roles.
  cnic          String?
  role          Role
  isActive      Boolean  @default(true)
  /// A teacher's main (primary) subject - the subject they were hired for.
  /// Single-column SetNull FK (audit-style), re-checked in-tenant like
  /// Class.classTeacher. Null for non-teachers.
  mainSubjectId String?
  mainSubject   Subject? @relation("TeacherMainSubject", fields: [mainSubjectId], references: [id], onDelete: SetNull)

  teacherAssignments     TeacherAssignment[]
  classesLed             Class[]                 @relation("ClassTeacher")
  sectionsLed            Section[]               @relation("SectionTeacher")
  timetable              TimetableEntry[]
  parentLinks            ParentStudent[]
  attendanceMarked       Attendance[]
  // Staff attendance where this user is the staff member, and (separately) the
  // rows this user marked as HEAD. Two relations to the same table.
  staffAttendance        StaffAttendance[]       @relation("StaffAttendanceStaff")
  staffAttendanceMarked  StaffAttendance[]       @relation("StaffAttendanceMarker")
  plannerEntries         PlannerEntry[]
  meetingsCreated        Meeting[]
  meetingInvites         MeetingInvitee[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  diaryEntries           DiaryEntry[]
  paymentsRecorded       Payment[]
  examResultsRecorded    ExamResult[]
  examPapers             ExamPaper[]             @relation("ExamPaperTeacher")
  examPapersReviewed     ExamPaper[]             @relation("ExamPaperReviewer")
  redFlagsResolved       RedFlag[]
  classNotesCreated      ClassNote[]             @relation("ClassNoteAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@index([mainSubjectId])
  @@map("users")
}

/// A grade/year within a school (e.g. "Grade 1"). `level` gives an explicit
/// ordering for display and for academic-year promotion later (Module 10.4).
/// Tenant-scoped: RLS pins every row to one school (see the enable_rls_* migration).
model Class {
  id             String  @id @default(cuid())
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  level          Int?
  /// The class (homeroom) teacher - the single teacher in charge of this class,
  /// distinct from the per-subject `teacherAssignments`. Optional. A single-
  /// column SetNull FK (audit-style): composite SetNull would force `schoolId`
  /// NULL and break the NOT NULL constraint, so tenant-safety is re-checked in
  /// the service (the teacher must resolve in-tenant with role TEACHER).
  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  /// Whether this class is divided into sections. Chosen at creation; it's only
  /// the default/intent - sections can still be added to any class later.
  hasSections    Boolean @default(true)

  sections           Section[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  attendance         Attendance[]
  diaryEntries       DiaryEntry[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  exams              Exam[]
  examPapers         ExamPaper[]
  timetableEntries   TimetableEntry[]
  plannerEntries     PlannerEntry[]
  classNotes         ClassNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@index([classTeacherId])
  @@map("classes")
}

/// A section/division of a Class (e.g. "A", "B"). `schoolId` is denormalized
/// from the parent Class so this table can carry its own RLS policy.
model Section {
  id               String  @id @default(cuid())
  schoolId         String
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId          String
  // Composite FK: the parent class must belong to the same school.
  class            Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  name             String
  /// The section's teacher (section in-charge), distinct from the class's main
  /// teacher. Optional. A single-column SetNull FK like `Class.classTeacher`:
  /// composite SetNull would force `schoolId` NULL, so tenant-safety is re-
  /// checked in the service (the teacher must resolve in-tenant with role TEACHER).
  sectionTeacherId String?
  sectionTeacher   User?   @relation("SectionTeacher", fields: [sectionTeacherId], references: [id], onDelete: SetNull)

  students     Student[]
  attendance   Attendance[]
  diaryEntries DiaryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionTeacherId])
  @@map("sections")
}

/// A student enrolled in a class (and optionally a section). A tenant record,
/// not a login account — a STUDENT User may be linked later for the portal.
/// Composite FKs keep class/section in the same school; the service also checks
/// the section belongs to the chosen class.
model Student {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String
  class         Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId     String?
  section       Section?  @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  name          String
  rollNumber    String?
  /// Guardian details. `fatherCnic` is the Pakistani CNIC (13 digits, stored
  /// normalized without dashes). Both optional.
  fatherName    String?
  fatherCnic    String?
  gender        Gender?
  dateOfBirth   DateTime? @db.Date
  /// When the student was admitted to the school. Optional; a date-only value.
  admissionDate DateTime? @db.Date
  isActive      Boolean   @default(true)

  parentLinks ParentStudent[]
  attendance  Attendance[]
  invoices    Invoice[]
  examResults ExamResult[]
  redFlags    RedFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, rollNumber])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@map("students")
}

/// Links a parent (a User with role PARENT) to a student. Many-to-many: a
/// parent can have several children, a student several guardians. Tenant-scoped
/// via RLS with composite FKs to keep parent and student in the same school.
model ParentStudent {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User              @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  relation  GuardianRelation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER

  @@map("guardian_relation")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

/// A subject taught at the school (e.g. "Mathematics"). `code` is an optional
/// short identifier (e.g. "MATH"). Tenant-scoped via RLS. Teacher/class
/// assignment arrives in Module 2.3.
model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  teacherAssignments TeacherAssignment[]
  diaryEntries       DiaryEntry[]
  examSubjects       ExamSubject[]
  examPapers         ExamPaper[]
  timetableEntries   TimetableEntry[]
  plannerEntries     PlannerEntry[]
  mainForTeachers    User[]              @relation("TeacherMainSubject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("subjects")
}

/// Links a teacher (a User with role TEACHER) to a subject they teach in a
/// class — "teaches Mathematics to Grade 1". Tenant-scoped via RLS; all three
/// references plus `schoolId` live in the same school.
model TeacherAssignment {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Composite FKs: teacher, subject, and class must all be in the same school.
  teacherId String
  teacher   User    @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

/// One slot in a teacher's weekly timetable: on a given `day`, `period` number,
/// the teacher takes `subject` with `class`. Composite FKs keep teacher, subject
/// and class in the same school (RLS-safe). `@@unique([teacherId, day, period])`
/// stops a teacher being double-booked in the same slot. Tenant-scoped via RLS.
model TimetableEntry {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User    @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  day       Weekday
  period    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, day, period])
  @@index([schoolId])
  @@index([teacherId])
  @@map("timetable_entries")
}

/// Days of the teaching week (Mon-Sat). Enum order is the sort order.
enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT

  @@map("weekday")
}

/// A daily attendance record: one row per student per calendar day (Module 3.1).
/// `classId`/`sectionId` are captured at mark-time (not read live off the
/// student) so historical reports stay correct after a promotion changes the
/// student's class. `markedById` is the User (teacher/head) who recorded it;
/// SetNull keeps the history if that account is later removed. Tenant-scoped via
/// RLS with composite FKs so student, class, section, and marker share a school.
model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  classId    String
  class      Class            @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId  String?
  section    Section?         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  // Audit only: always the in-tenant session user, set server-side (never from
  // client input), so a single-column FK is safe here — the composite form
  // would force schoolId to NULL on SetNull and break the NOT NULL constraint.
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId, date])
  @@index([date])
  @@map("attendance")
}

/// Daily attendance outcome. LEAVE is an approved/excused absence (distinct from
/// an unexplained ABSENT, which drives the Module 4.6 parent alert).
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@map("attendance_status")
}

/// A daily staff-attendance record: one row per staff member (a TEACHER User)
/// per calendar day (Module 8.1). Mirrors student `Attendance` but flat — staff
/// aren't grouped by class/section. A HEAD marks it; `markedById` is that actor,
/// a single-column SetNull FK (audit only, like Attendance.markedBy), so the
/// history survives if the account is later removed (the composite SetNull form
/// would force schoolId NULL and break the NOT NULL constraint). The staff
/// member is pinned to the same school by a composite FK. Reuses the
/// `AttendanceStatus` outcome (PRESENT/ABSENT/LATE/LEAVE). One row per staff
/// member per day makes marking idempotent. Tenant-scoped via RLS.
model StaffAttendance {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId    String
  staff      User             @relation("StaffAttendanceStaff", fields: [schoolId, staffId], references: [schoolId, id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?
  markedBy   User?            @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([schoolId])
  @@index([staffId])
  @@index([date])
  @@map("staff_attendance")
}

/// A teacher's lesson-plan entry in the planner register (Module 8.2): for a
/// `date`, the `topic` and plan `details` (and optional planned `homework`) a
/// teacher intends to cover with a class in a subject. `status` lets the teacher
/// mark it taught (COMPLETED). The register is an internal staff record a HEAD
/// reviews - unlike the Module 5 diary it is not pushed to parents. `teacherId`
/// is the owning teacher (composite FK, cascade); class cascades too, while
/// subject uses NoAction so a subject still referenced by a plan can't be
/// deleted out from under it (history is preserved, as with the diary). One plan
/// per teacher/class/subject/day (`@@unique`) makes saving idempotent.
/// Tenant-scoped via RLS.
model PlannerEntry {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User          @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  classId   String
  class     Class         @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject       @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction)
  date      DateTime      @db.Date
  topic     String
  details   String
  homework  String?
  status    PlannerStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classId, subjectId, date])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([schoolId, date])
  @@map("planner_entries")
}

/// A planner entry's state: PLANNED until the teacher marks it taught (COMPLETED).
enum PlannerStatus {
  PLANNED
  COMPLETED

  @@map("planner_status")
}

/// A staff meeting a HEAD schedules for teachers (Module 8.3). `scheduledAt` is
/// a full timestamp (date + time). Invited teachers are linked via
/// `MeetingInvitee`; creating a meeting fans a MEETING notification out to them
/// through the Module 4 engine. `createdById` is the HEAD who scheduled it — a
/// single-column SetNull audit FK (like Attendance.markedBy), so the meeting
/// survives if that account is removed. Tenant-scoped via RLS;
/// `@@unique([schoolId, id])` lets invitees reference it with a tenant-safe
/// composite FK.
model Meeting {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  agenda      String?
  location    String?
  scheduledAt DateTime
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  invitees MeetingInvitee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, scheduledAt])
  @@map("meetings")
}

/// Links a staff meeting to an invited teacher (Module 8.3). Composite FKs keep
/// meeting and teacher in the same school; both cascade, so removing a meeting
/// (or a teacher) clears the invite. One row per (meeting, teacher).
/// Tenant-scoped via RLS.
model MeetingInvitee {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting @relation(fields: [schoolId, meetingId], references: [schoolId, id], onDelete: Cascade)
  teacherId String
  teacher   User    @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, teacherId])
  @@index([schoolId])
  @@index([meetingId])
  @@index([teacherId])
  @@map("meeting_invitees")
}

/// A homework assignment or daily-diary note a teacher posts for a class
/// (Module 5). One entry targets a class and, optionally, a single section
/// (null = the whole class) and a subject (null for a general NOTE). `date` is
/// the day it's posted for; `dueDate` is optional (homework). Class/section/
/// subject use composite FKs so all stay in one school; `createdById` is a
/// single-column FK (SetNull) to the posting teacher/head — audit only, so the
/// entry survives if that account is later removed (the composite SetNull form
/// would force schoolId NULL, as with Attendance.markedBy). Tenant-scoped via
/// RLS. Posting an entry fans a HOMEWORK_POSTED notification out to the parents
/// of the targeted students (Module 5.3).
model DiaryEntry {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId   String?
  section     Section?  @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  subjectId   String?
  subject     Subject?  @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction)
  type        DiaryType @default(HOMEWORK)
  date        DateTime  @db.Date
  title       String
  content     String
  dueDate     DateTime? @db.Date
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId, date])
  @@index([schoolId, date])
  @@map("diary_entries")
}

/// What a diary entry is: HOMEWORK (usually with a subject and maybe a due
/// date) or a general NOTE/announcement for the class.
enum DiaryType {
  HOMEWORK
  NOTE

  @@map("diary_type")
}

/// A bucket a fee belongs to (e.g. "Tuition", "Transport", "Exam",
/// "Admission") (Module 6.1). Tenant-scoped via RLS; names are unique per
/// school. `@@unique([schoolId, id])` lets fee structures reference it with a
/// tenant-safe composite FK.
model FeeCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  structures FeeStructure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_categories")
}

/// How often a fee recurs.
enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME

  @@map("fee_frequency")
}

/// A single fee definition: an `amount` in a category, optionally pinned to one
/// class (null = applies to every class), billed at a `frequency` (Module 6.1).
/// This is the template invoices are generated from in Module 6.2, so it also
/// carries `@@unique([schoolId, id])` for a future composite FK. Category and
/// class use composite FKs so all three stay in one school. Amount is money, so
/// it's a fixed-scale Decimal, never a float. Tenant-scoped via RLS.
model FeeStructure {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId String
  category   FeeCategory  @relation(fields: [schoolId, categoryId], references: [schoolId, id], onDelete: Cascade)
  classId    String?
  class      Class?       @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  label      String?
  amount     Decimal      @db.Decimal(10, 2)
  frequency  FeeFrequency @default(MONTHLY)
  isActive   Boolean      @default(true)

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("fee_structures")
}

/// How an invoice stands relative to what's been paid (Module 6.2). Set to
/// UNPAID at generation; payments (Module 6.3) move it to PARTIAL/PAID.
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED

  @@map("invoice_status")
}

/// A bill issued to one student for a billing period (Module 6.2). Generated
/// from the fee structure: one `InvoiceLineItem` per applicable fee, with
/// `total` the sum. `period` is the billing month ("YYYY-MM"); the
/// `@@unique([studentId, period])` key makes generation idempotent (re-running
/// a month never double-bills). `classId` is captured at generation so reports
/// stay correct after a promotion. `paidAmount` starts at 0 and is maintained
/// by payments in Module 6.3; balance is `total - paidAmount`. Tenant-scoped
/// via RLS with composite FKs; `@@unique([schoolId, id])` lets payments
/// reference it tenant-safely.
model Invoice {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student       @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  classId    String?
  class      Class?        @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction)
  period     String
  title      String
  dueDate    DateTime?     @db.Date
  status     InvoiceStatus @default(UNPAID)
  total      Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, period])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([classId, period])
  @@map("invoices")
}

/// One charge on an invoice (Module 6.2), usually copied from a FeeStructure at
/// generation. `description`/`amount` are snapshotted so the invoice is stable
/// even if the fee definition later changes; `feeStructureId` keeps the link
/// for reference (NoAction, so history isn't lost). Tenant-scoped via RLS.
model InvoiceLineItem {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: NoAction)
  description    String
  amount         Decimal       @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// How a payment was made (Module 6.3).
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  JAZZCASH
  EASYPAISA
  OTHER

  @@map("payment_method")
}

/// A payment's verification state (Module 6.3). A HEAD's manual entry is
/// VERIFIED immediately; a parent-submitted bank transfer starts PENDING and a
/// HEAD moves it to VERIFIED (applied to the invoice) or REJECTED. Only
/// VERIFIED payments count toward an invoice's `paidAmount`.
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("payment_status")
}

/// A payment recorded against an invoice (Module 6.3). Office/HEAD records
/// manual payments (cash, cheque, verified bank transfer) which apply at once;
/// a parent can submit a bank-transfer claim (amount + bank `reference`) that
/// stays PENDING until a HEAD verifies it. Applying a payment recomputes the
/// invoice's `paidAmount`/`status` from the sum of its VERIFIED payments.
/// `recordedById` is the actor who entered it (HEAD or the submitting parent) —
/// a single-column SetNull FK (audit only), so the payment survives if that
/// account is removed. Tenant-scoped via RLS; invoice via a composite FK.
model Payment {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice       @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  status       PaymentStatus @default(VERIFIED)
  note         String?
  recordedById String?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([invoiceId])
  @@map("payments")
}

/// An assessment event for one class (Module 7.1) — e.g. "First Term Exam" or
/// "October Monthly Test". An exam groups the subject papers a class sits
/// together (`ExamSubject`); each student's marks per paper are recorded as
/// `ExamResult`. `type` classifies it (term exam, monthly test, quiz, …) and
/// `term` is an optional free-text grouping ("Term 1", "2025-2026") that report
/// cards (Module 7.2) aggregate by. `classId` is a composite FK so the exam
/// stays in one school. `isPublished` gates whether results are visible to
/// parents/students — results are published as report cards in Module 7.2.
/// Tenant-scoped via RLS; `@@unique([schoolId, id])` lets exam subjects
/// reference it with a tenant-safe composite FK.
model Exam {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  name        String
  type        ExamType  @default(TERM)
  term        String?
  startDate   DateTime? @db.Date
  isPublished Boolean   @default(false)

  subjects ExamSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("exams")
}

/// The kind of assessment an Exam represents (Module 7.1).
enum ExamType {
  TERM
  MIDTERM
  FINAL
  MONTHLY
  QUIZ
  ASSIGNMENT
  OTHER

  @@map("exam_type")
}

/// One subject paper within an Exam (Module 7.1) — e.g. "Mathematics" in the
/// First Term Exam — carrying that paper's `maxMarks` and an optional
/// `passMarks`. Composite FKs keep exam and subject in one school: the exam
/// cascades (deleting an exam removes its papers), while the subject uses
/// NoAction so a subject still referenced by an exam can't be deleted out from
/// under it (history is preserved, as with diary/invoice references). One row
/// per subject per exam. Marks are a fixed-scale Decimal, never a float.
/// Tenant-scoped via RLS; `@@unique([schoolId, id])` lets results reference it
/// with a tenant-safe composite FK.
model ExamSubject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction)
  maxMarks  Decimal  @db.Decimal(6, 2)
  passMarks Decimal? @db.Decimal(6, 2)

  results ExamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, subjectId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([examId])
  @@map("exam_subjects")
}

/// One student's result for one subject paper in an exam (Module 7.1). Marks
/// are entered in Module 7.2, so `marksObtained` is null until entered;
/// `isAbsent` records a student who missed the paper (distinct from a scored
/// zero). Composite FKs keep exam-subject and student in one school, both
/// cascading so results clear when either is removed. `recordedById` is the
/// actor who entered the mark — a single-column SetNull FK (audit only, like
/// Attendance.markedBy), so the result survives if that account is later
/// removed. One row per student per paper, which makes mark entry idempotent.
/// Tenant-scoped via RLS.
model ExamResult {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [schoolId, examSubjectId], references: [schoolId, id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  marksObtained Decimal?    @db.Decimal(6, 2)
  isAbsent      Boolean     @default(false)
  remarks       String?
  recordedById  String?
  recordedBy    User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@index([examSubjectId])
  @@map("exam_results")
}

/// A question paper a TEACHER submits for a HEAD to review ahead of an exam
/// (Module 7). Standalone - it carries its own `classId`, `subjectId` and
/// `examDate`, so a paper can be submitted before any Exam record exists and
/// isn't tied to the marks tables. The paper itself is an external `fileUrl`
/// (a Drive/OneDrive link); the app stores no files. Review is a short loop:
/// SUBMITTED -> APPROVED or CHANGES_REQUESTED, with an optional `reviewNote`
/// the teacher sees. `reviewedById` is the HEAD who acted - a single-column
/// SetNull audit FK (like Meeting.createdById), so the paper survives if that
/// account is removed. Teacher/class/subject use composite FKs so all three
/// stay in one school (class cascades, subject NoAction to preserve history).
/// Tenant-scoped via RLS.
model ExamPaper {
  id           String          @id @default(cuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User            @relation("ExamPaperTeacher", fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  classId      String
  class        Class           @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  subjectId    String
  subject      Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction)
  title        String
  examDate     DateTime        @db.Date
  fileUrl      String
  notes        String?
  status       ExamPaperStatus @default(SUBMITTED)
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?           @relation("ExamPaperReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([teacherId])
  @@index([classId])
  @@map("exam_papers")
}

/// An exam paper's review state (Module 7): SUBMITTED by the teacher until a
/// HEAD either APPROVES it or asks for changes (CHANGES_REQUESTED, usually with
/// a note). A teacher may revise and re-submit while it isn't approved.
enum ExamPaperStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED

  @@map("exam_paper_status")
}

/// An at-risk indicator raised for a student (Module 7.3) when a rule crosses a
/// threshold — low attendance in a month, or weak results in a published exam.
/// A HEAD-triggered scan evaluates the rules and upserts flags; `key` makes a
/// flag idempotent per student and context (e.g. "ATTENDANCE_LOW:2026-10",
/// "EXAM_RESULT:<examId>"), so re-scanning refreshes the detail instead of
/// duplicating. `title`/`detail` are the human-readable explanation shown to
/// staff and carried into the RED_FLAG alert. `status` lets a HEAD resolve a
/// flag they've acted on (and reopen it); `resolvedById` is a single-column
/// SetNull audit FK to the actor (like Attendance.markedBy), so the flag
/// survives if that account is removed. Tenant-scoped via RLS; the student is
/// pinned to the same school by a composite FK.
model RedFlag {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student       @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  type         RedFlagType
  key          String
  title        String
  detail       String
  status       RedFlagStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?         @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, key])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([studentId])
  @@map("red_flags")
}

/// What kind of rule raised a red flag (Module 7.3).
enum RedFlagType {
  ATTENDANCE_LOW
  GRADES_LOW

  @@map("red_flag_type")
}

/// A red flag's lifecycle: OPEN until a HEAD acts on it, then RESOLVED (and it
/// can be reopened).
enum RedFlagStatus {
  OPEN
  RESOLVED

  @@map("red_flag_status")
}

/// A qualitative note a HEAD logs against a class (Module 7.4 - class progress).
/// Unlike the student-centric exam/attendance records, these capture the softer
/// signals that feed the all-classes progress dashboard: a HEAD_VISIT note from
/// a classroom visit, a GENERAL observation, an ASSEMBLY activity the class took
/// part in, or a PARENT_COMMENT the office received (recorded by the HEAD on the
/// parent's behalf - a parent-authored flow comes later). `date` is the day the
/// note is for; `title` is a short line and `body` the detail. `createdById` is
/// the logging HEAD - a single-column SetNull audit FK (like Attendance.markedBy),
/// so the note survives if that account is removed; the composite SetNull form
/// would force schoolId NULL and break the NOT NULL constraint. The class is
/// pinned to the same school by a composite FK (cascade). Tenant-scoped via RLS.
model ClassNote {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class         @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  type        ClassNoteType @default(GENERAL)
  date        DateTime      @db.Date
  title       String
  body        String
  createdById String?
  createdBy   User?         @relation("ClassNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([schoolId, date])
  @@map("class_notes")
}

/// What a class note records (Module 7.4): a HEAD classroom visit, a general
/// observation, an assembly activity, or a parent comment the office received.
enum ClassNoteType {
  HEAD_VISIT
  GENERAL
  ASSEMBLY
  PARENT_COMMENT

  @@map("class_note_type")
}

/// A delivered notification for one recipient (Module 4.1). This is the in-app
/// channel's record: one row per (event, recipient). The notification engine is
/// channel-agnostic — an event is dispatched once and each enabled channel
/// (in-app now; email/WhatsApp/push in Modules 4.2-4.4) delivers it its own way;
/// in-app delivery writes a row here. `type` classifies the originating event so
/// the UI can group/route it; `data` carries structured context (e.g. the
/// student and date behind an attendance alert) for rendering deep links without
/// another lookup. Tenant-scoped via RLS; the recipient is pinned to the same
/// school through a composite FK.
model Notification {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  body        String
  data        Json?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  // Serves the per-recipient inbox query and the unread-count badge.
  @@index([schoolId, recipientId, readAt, createdAt])
  @@map("notifications")
}

/// A Web Push (FCM) registration token for one user's browser/device (Module
/// 4.4). One row per token; a user may have several (multiple devices). Tokens
/// are opaque FCM registration tokens obtained client-side via the Firebase
/// SDK. Tenant-scoped via RLS with a composite FK to the owning user. Dead
/// tokens are pruned by the channel when FCM reports them unregistered.
model PushSubscription {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User    @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  token       String
  userAgent   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, token])
  @@index([schoolId])
  @@index([schoolId, recipientId])
  @@map("push_subscriptions")
}

/// A notification queued for later delivery (Module 4.5). Instead of sending
/// inline, a caller enqueues a row with a `sendAt`; the scheduler's per-minute
/// cron flush (`src/server/scheduler`) picks up every row whose `sendAt` has
/// passed and dispatches it through the notification engine, then stamps
/// `sentAt`. This is the backbone for scheduled and batched sends — fee
/// reminders (Module 6.4), attendance digests, etc. enqueue here rather than
/// blocking a request on delivery. `channels` names the delivery channels (the
/// `ChannelName` union, stored as text); `attempts`/`lastError` give the flush
/// a simple retry trail. Tenant-scoped via RLS; the recipient is pinned to the
/// same school by a composite FK.
model ScheduledNotification {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  body        String
  data        Json?
  channels    String[]
  /// When the notification becomes due. The flush delivers rows with
  /// `sendAt <= now()` and `sentAt IS NULL`.
  sendAt      DateTime
  /// Set once delivery has been dispatched; a non-null value means "done" and
  /// the flush skips it thereafter.
  sentAt      DateTime?
  attempts    Int              @default(0)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  // Serves the flush query: unsent rows ordered by when they came due.
  @@index([sentAt, sendAt])
  @@map("scheduled_notifications")
}

/// The kind of event a notification came from. Starts small and grows as the
/// modules that emit events land (homework in Module 5, fees in Module 6, …).
/// GENERAL is the default for ad-hoc/system messages with no dedicated type.
enum NotificationType {
  GENERAL
  ATTENDANCE_ABSENT
  HOMEWORK_POSTED
  FEE_REMINDER
  RED_FLAG
  MEETING

  @@map("notification_type")
}
