// Prisma schema for the School Management SaaS.
// Docs: https://pris.ly/d/prisma-schema
//
// Models are added per roadmap module:
//   Module 1.1 — School (tenant)
//   Module 1.2 — User (roles, scoped by schoolId)
//   ...and onward. This baseline establishes the datasource, generator,
//   and migration pipeline only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in `prisma.config.ts` (for the CLI)
  // and is passed via a driver adapter to `PrismaClient` at runtime.
}

/// A School is the tenant. Every tenant-scoped record (users, students,
/// attendance, fees, …) will reference a School via `schoolId`, and in
/// Module 1.5 PostgreSQL Row-Level Security pins queries to one tenant.
///
/// `slug` is the stable, URL-safe handle used to resolve the active tenant
/// (subdomain or path). `isActive` lets a SUPER_ADMIN suspend a tenant
/// without deleting its data.
model School {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  users              User[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  parentStudents     ParentStudent[]
  attendance             Attendance[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  diaryEntries           DiaryEntry[]
  feeCategories          FeeCategory[]
  feeStructures          FeeStructure[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  payments               Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

/// Roles are hierarchical in practice but stored flat; access control
/// (Module 1.4) maps each role to its permissions.
///   SUPER_ADMIN — platform operator; not tied to any tenant (schoolId null)
///   HEAD        — school owner/principal; full control within their school
///   TEACHER     — marks attendance, posts homework, enters grades
///   PARENT      — views their children's data
///   STUDENT     — views their own data
enum Role {
  SUPER_ADMIN
  HEAD
  TEACHER
  PARENT
  STUDENT

  @@map("role")
}

/// An authenticated account, scoped to one School via `schoolId`. The only
/// exception is SUPER_ADMIN, whose `schoolId` is null because it operates
/// above any single tenant. Email is unique *per school* (compound unique),
/// so the same address can belong to a parent at two different schools.
model User {
  id           String  @id @default(cuid())
  schoolId     String?
  school       School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  /// Contact number in E.164 form (e.g. "923001234567"), used by the WhatsApp
  /// notification channel (Module 4.3). Optional: not every account has one.
  phone        String?
  role         Role
  isActive     Boolean @default(true)

  teacherAssignments TeacherAssignment[]
  parentLinks        ParentStudent[]
  attendanceMarked   Attendance[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  diaryEntries       DiaryEntry[]
  paymentsRecorded   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("users")
}

/// A grade/year within a school (e.g. "Grade 1"). `level` gives an explicit
/// ordering for display and for academic-year promotion later (Module 10.4).
/// Tenant-scoped: RLS pins every row to one school (see the enable_rls_* migration).
model Class {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  level    Int?

  sections           Section[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  attendance         Attendance[]
  diaryEntries       DiaryEntry[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("classes")
}

/// A section/division of a Class (e.g. "A", "B"). `schoolId` is denormalized
/// from the parent Class so this table can carry its own RLS policy.
model Section {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  // Composite FK: the parent class must belong to the same school.
  class    Class  @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  name     String

  students     Student[]
  attendance   Attendance[]
  diaryEntries DiaryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

/// A student enrolled in a class (and optionally a section). A tenant record,
/// not a login account — a STUDENT User may be linked later for the portal.
/// Composite FKs keep class/section in the same school; the service also checks
/// the section belongs to the chosen class.
model Student {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId   String?
  section     Section?  @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  name        String
  rollNumber  String?
  gender      Gender?
  dateOfBirth DateTime?
  isActive    Boolean   @default(true)

  parentLinks ParentStudent[]
  attendance  Attendance[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, rollNumber])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@map("students")
}

/// Links a parent (a User with role PARENT) to a student. Many-to-many: a
/// parent can have several children, a student several guardians. Tenant-scoped
/// via RLS with composite FKs to keep parent and student in the same school.
model ParentStudent {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User              @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  relation  GuardianRelation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER

  @@map("guardian_relation")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

/// A subject taught at the school (e.g. "Mathematics"). `code` is an optional
/// short identifier (e.g. "MATH"). Tenant-scoped via RLS. Teacher/class
/// assignment arrives in Module 2.3.
model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  teacherAssignments TeacherAssignment[]
  diaryEntries       DiaryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("subjects")
}

/// Links a teacher (a User with role TEACHER) to a subject they teach in a
/// class — "teaches Mathematics to Grade 1". Tenant-scoped via RLS; all three
/// references plus `schoolId` live in the same school.
model TeacherAssignment {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Composite FKs: teacher, subject, and class must all be in the same school.
  teacherId String
  teacher   User    @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

/// A daily attendance record: one row per student per calendar day (Module 3.1).
/// `classId`/`sectionId` are captured at mark-time (not read live off the
/// student) so historical reports stay correct after a promotion changes the
/// student's class. `markedById` is the User (teacher/head) who recorded it;
/// SetNull keeps the history if that account is later removed. Tenant-scoped via
/// RLS with composite FKs so student, class, section, and marker share a school.
model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  classId    String
  class      Class            @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId  String?
  section    Section?         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  // Audit only: always the in-tenant session user, set server-side (never from
  // client input), so a single-column FK is safe here — the composite form
  // would force schoolId to NULL on SetNull and break the NOT NULL constraint.
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId, date])
  @@index([date])
  @@map("attendance")
}

/// Daily attendance outcome. LEAVE is an approved/excused absence (distinct from
/// an unexplained ABSENT, which drives the Module 4.6 parent alert).
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@map("attendance_status")
}

/// A homework assignment or daily-diary note a teacher posts for a class
/// (Module 5). One entry targets a class and, optionally, a single section
/// (null = the whole class) and a subject (null for a general NOTE). `date` is
/// the day it's posted for; `dueDate` is optional (homework). Class/section/
/// subject use composite FKs so all stay in one school; `createdById` is a
/// single-column FK (SetNull) to the posting teacher/head — audit only, so the
/// entry survives if that account is later removed (the composite SetNull form
/// would force schoolId NULL, as with Attendance.markedBy). Tenant-scoped via
/// RLS. Posting an entry fans a HOMEWORK_POSTED notification out to the parents
/// of the targeted students (Module 5.3).
model DiaryEntry {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  sectionId   String?
  section     Section?  @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction)
  subjectId   String?
  subject     Subject?  @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction)
  type        DiaryType @default(HOMEWORK)
  date        DateTime  @db.Date
  title       String
  content     String
  dueDate     DateTime? @db.Date
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId, date])
  @@index([schoolId, date])
  @@map("diary_entries")
}

/// What a diary entry is: HOMEWORK (usually with a subject and maybe a due
/// date) or a general NOTE/announcement for the class.
enum DiaryType {
  HOMEWORK
  NOTE

  @@map("diary_type")
}

/// A bucket a fee belongs to (e.g. "Tuition", "Transport", "Exam",
/// "Admission") (Module 6.1). Tenant-scoped via RLS; names are unique per
/// school. `@@unique([schoolId, id])` lets fee structures reference it with a
/// tenant-safe composite FK.
model FeeCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  structures FeeStructure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_categories")
}

/// How often a fee recurs.
enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME

  @@map("fee_frequency")
}

/// A single fee definition: an `amount` in a category, optionally pinned to one
/// class (null = applies to every class), billed at a `frequency` (Module 6.1).
/// This is the template invoices are generated from in Module 6.2, so it also
/// carries `@@unique([schoolId, id])` for a future composite FK. Category and
/// class use composite FKs so all three stay in one school. Amount is money, so
/// it's a fixed-scale Decimal, never a float. Tenant-scoped via RLS.
model FeeStructure {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId String
  category   FeeCategory  @relation(fields: [schoolId, categoryId], references: [schoolId, id], onDelete: Cascade)
  classId    String?
  class      Class?       @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  label      String?
  amount     Decimal      @db.Decimal(10, 2)
  frequency  FeeFrequency @default(MONTHLY)
  isActive   Boolean      @default(true)

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("fee_structures")
}

/// How an invoice stands relative to what's been paid (Module 6.2). Set to
/// UNPAID at generation; payments (Module 6.3) move it to PARTIAL/PAID.
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED

  @@map("invoice_status")
}

/// A bill issued to one student for a billing period (Module 6.2). Generated
/// from the fee structure: one `InvoiceLineItem` per applicable fee, with
/// `total` the sum. `period` is the billing month ("YYYY-MM"); the
/// `@@unique([studentId, period])` key makes generation idempotent (re-running
/// a month never double-bills). `classId` is captured at generation so reports
/// stay correct after a promotion. `paidAmount` starts at 0 and is maintained
/// by payments in Module 6.3; balance is `total - paidAmount`. Tenant-scoped
/// via RLS with composite FKs; `@@unique([schoolId, id])` lets payments
/// reference it tenant-safely.
model Invoice {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student       @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  classId    String?
  class      Class?        @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction)
  period     String
  title      String
  dueDate    DateTime?     @db.Date
  status     InvoiceStatus @default(UNPAID)
  total      Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, period])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([classId, period])
  @@map("invoices")
}

/// One charge on an invoice (Module 6.2), usually copied from a FeeStructure at
/// generation. `description`/`amount` are snapshotted so the invoice is stable
/// even if the fee definition later changes; `feeStructureId` keeps the link
/// for reference (NoAction, so history isn't lost). Tenant-scoped via RLS.
model InvoiceLineItem {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: NoAction)
  description    String
  amount         Decimal       @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// How a payment was made (Module 6.3).
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  JAZZCASH
  EASYPAISA
  OTHER

  @@map("payment_method")
}

/// A payment's verification state (Module 6.3). A HEAD's manual entry is
/// VERIFIED immediately; a parent-submitted bank transfer starts PENDING and a
/// HEAD moves it to VERIFIED (applied to the invoice) or REJECTED. Only
/// VERIFIED payments count toward an invoice's `paidAmount`.
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("payment_status")
}

/// A payment recorded against an invoice (Module 6.3). Office/HEAD records
/// manual payments (cash, cheque, verified bank transfer) which apply at once;
/// a parent can submit a bank-transfer claim (amount + bank `reference`) that
/// stays PENDING until a HEAD verifies it. Applying a payment recomputes the
/// invoice's `paidAmount`/`status` from the sum of its VERIFIED payments.
/// `recordedById` is the actor who entered it (HEAD or the submitting parent) —
/// a single-column SetNull FK (audit only), so the payment survives if that
/// account is removed. Tenant-scoped via RLS; invoice via a composite FK.
model Payment {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice       @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  status       PaymentStatus @default(VERIFIED)
  note         String?
  recordedById String?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([invoiceId])
  @@map("payments")
}

/// A delivered notification for one recipient (Module 4.1). This is the in-app
/// channel's record: one row per (event, recipient). The notification engine is
/// channel-agnostic — an event is dispatched once and each enabled channel
/// (in-app now; email/WhatsApp/push in Modules 4.2-4.4) delivers it its own way;
/// in-app delivery writes a row here. `type` classifies the originating event so
/// the UI can group/route it; `data` carries structured context (e.g. the
/// student and date behind an attendance alert) for rendering deep links without
/// another lookup. Tenant-scoped via RLS; the recipient is pinned to the same
/// school through a composite FK.
model Notification {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  body        String
  data        Json?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  // Serves the per-recipient inbox query and the unread-count badge.
  @@index([schoolId, recipientId, readAt, createdAt])
  @@map("notifications")
}

/// A Web Push (FCM) registration token for one user's browser/device (Module
/// 4.4). One row per token; a user may have several (multiple devices). Tokens
/// are opaque FCM registration tokens obtained client-side via the Firebase
/// SDK. Tenant-scoped via RLS with a composite FK to the owning user. Dead
/// tokens are pruned by the channel when FCM reports them unregistered.
model PushSubscription {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User   @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  token       String
  userAgent   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, token])
  @@index([schoolId])
  @@index([schoolId, recipientId])
  @@map("push_subscriptions")
}

/// A notification queued for later delivery (Module 4.5). Instead of sending
/// inline, a caller enqueues a row with a `sendAt`; the scheduler's per-minute
/// cron flush (`src/server/scheduler`) picks up every row whose `sendAt` has
/// passed and dispatches it through the notification engine, then stamps
/// `sentAt`. This is the backbone for scheduled and batched sends — fee
/// reminders (Module 6.4), attendance digests, etc. enqueue here rather than
/// blocking a request on delivery. `channels` names the delivery channels (the
/// `ChannelName` union, stored as text); `attempts`/`lastError` give the flush
/// a simple retry trail. Tenant-scoped via RLS; the recipient is pinned to the
/// same school by a composite FK.
model ScheduledNotification {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [schoolId, recipientId], references: [schoolId, id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  body        String
  data        Json?
  channels    String[]
  /// When the notification becomes due. The flush delivers rows with
  /// `sendAt <= now()` and `sentAt IS NULL`.
  sendAt      DateTime
  /// Set once delivery has been dispatched; a non-null value means "done" and
  /// the flush skips it thereafter.
  sentAt      DateTime?
  attempts    Int              @default(0)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  // Serves the flush query: unsent rows ordered by when they came due.
  @@index([sentAt, sendAt])
  @@map("scheduled_notifications")
}

/// The kind of event a notification came from. Starts small and grows as the
/// modules that emit events land (homework in Module 5, fees in Module 6, …).
/// GENERAL is the default for ad-hoc/system messages with no dedicated type.
enum NotificationType {
  GENERAL
  ATTENDANCE_ABSENT
  HOMEWORK_POSTED
  FEE_REMINDER

  @@map("notification_type")
}
