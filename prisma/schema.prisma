// Prisma schema for the School Management SaaS.
// Docs: https://pris.ly/d/prisma-schema
//
// Models are added per roadmap module:
//   Module 1.1 — School (tenant)
//   Module 1.2 — User (roles, scoped by schoolId)
//   ...and onward. This baseline establishes the datasource, generator,
//   and migration pipeline only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in `prisma.config.ts` (for the CLI)
  // and is passed via a driver adapter to `PrismaClient` at runtime.
}

/// A School is the tenant. Every tenant-scoped record (users, students,
/// attendance, fees, …) will reference a School via `schoolId`, and in
/// Module 1.5 PostgreSQL Row-Level Security pins queries to one tenant.
///
/// `slug` is the stable, URL-safe handle used to resolve the active tenant
/// (subdomain or path). `isActive` lets a SUPER_ADMIN suspend a tenant
/// without deleting its data.
model School {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  email    String?
  phone    String?
  address  String?
  isActive Boolean @default(true)

  users              User[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

/// Roles are hierarchical in practice but stored flat; access control
/// (Module 1.4) maps each role to its permissions.
///   SUPER_ADMIN — platform operator; not tied to any tenant (schoolId null)
///   HEAD        — school owner/principal; full control within their school
///   TEACHER     — marks attendance, posts homework, enters grades
///   PARENT      — views their children's data
///   STUDENT     — views their own data
enum Role {
  SUPER_ADMIN
  HEAD
  TEACHER
  PARENT
  STUDENT

  @@map("role")
}

/// An authenticated account, scoped to one School via `schoolId`. The only
/// exception is SUPER_ADMIN, whose `schoolId` is null because it operates
/// above any single tenant. Email is unique *per school* (compound unique),
/// so the same address can belong to a parent at two different schools.
model User {
  id           String  @id @default(cuid())
  schoolId     String?
  school       School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("users")
}

/// A grade/year within a school (e.g. "Grade 1"). `level` gives an explicit
/// ordering for display and for academic-year promotion later (Module 10.4).
/// Tenant-scoped: RLS pins every row to one school (see the enable_rls_* migration).
model Class {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  level    Int?

  sections           Section[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("classes")
}

/// A section/division of a Class (e.g. "A", "B"). `schoolId` is denormalized
/// from the parent Class so this table can carry its own RLS policy.
model Section {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  // Composite FK: the parent class must belong to the same school.
  class    Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

/// A subject taught at the school (e.g. "Mathematics"). `code` is an optional
/// short identifier (e.g. "MATH"). Tenant-scoped via RLS. Teacher/class
/// assignment arrives in Module 2.3.
model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // enables composite (tenant-safe) foreign keys
  @@index([schoolId])
  @@map("subjects")
}

/// Links a teacher (a User with role TEACHER) to a subject they teach in a
/// class — "teaches Mathematics to Grade 1". Tenant-scoped via RLS; all three
/// references plus `schoolId` live in the same school.
model TeacherAssignment {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Composite FKs: teacher, subject, and class must all be in the same school.
  teacherId String
  teacher   User    @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("teacher_assignments")
}
